{
  "name": "bus-fyi-as",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run install:rust && npm run wasm:build && vite build && npm run generate:stops:parallel && npm run generate:stop-csvs",
    "download:gtfs": "node src/download-gtfs.mjs",
    "generate": "npm run asbuild && node src/generator.mjs",
    "generate:stops": "node src/generate-stops-rust.mjs",
    "generate:stops:parallel": "node src/generate-stops-rust-parallel.mjs",
    "generate:stop-csvs": "node src/generate-stop-csvs.mjs",
    "generate:stops:old": "node src/generate-stops-component-based.mjs",
    "generate:stops:esm": "node src/generate-stops-batched.mjs",
    "preview": "vite preview",
    "install:rust": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && export PATH=\"$HOME/.cargo/bin:$PATH\" && cargo install wasm-pack",
    "wasm:build": "wasm-pack build --target nodejs --out-dir pkg",
    "asbuild:debug": "asc src/modules/assembly/index.ts --target debug",
    "asbuild:release": "asc src/modules/assembly/index.ts --target release",
    "asbuild": "npm run asbuild:debug && npm run asbuild:release",
    "test": "node tests",
    "start": "npx serve ."
  },
  "devDependencies": {
    "@assemblyscript/loader": "^0.28.9",
    "assemblyscript": "^0.28.9",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "exports": {
    ".": {
      "import": "./dist/release.js",
      "types": "./dist/release.d.ts"
    }
  }
}
